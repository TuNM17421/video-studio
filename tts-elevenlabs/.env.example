# Copy to .env and fill in. Never share or commit .env.
ELEVENLABS_API_KEY=

# Giọng đọc giờ nằm ở voices.json (danh mục có tên, mẫu nghe thử, và một giọng mặc định).
# Để trống là dùng giọng mặc định đó; `--voice <id|tên>` thắng tất cả. Biến này chỉ còn là
# cách Video Studio truyền lựa chọn riêng của từng video xuống tts.mjs.
ELEVENLABS_VOICE_ID=

# Model must support Vietnamese (e.g. eleven_turbo_v2_5, eleven_flash_v2_5, eleven_v3 — check your plan).
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_LANGUAGE=vi
# Raw PCM so the master can be assembled frame-accurately (pcm_16000 · pcm_22050 · pcm_24000 · pcm_44100 on some plans).
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Voice settings (optional)
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1
