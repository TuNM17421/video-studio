# Copy to .env and fill in. Never share or commit .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Model must support Vietnamese: eleven_flash_v2_5 or eleven_v3 only. eleven_multilingual_v2 has no
# Vietnamese, and eleven_turbo_v2_5 is deprecated (flash_v2_5 is its drop-in replacement, same price).
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_LANGUAGE=vi
# Raw PCM so the master can be assembled frame-accurately (pcm_16000 · pcm_22050 · pcm_24000 · pcm_44100 on some plans).
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Voice settings (optional)
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1
