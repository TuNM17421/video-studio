# These are non-secret Studio policy switches. Do not put API keys in this file.
# Existing Studio videos created before provider support remain bound to Claude.
# claude | codex | antigravity
STUDIO_AGENT_PROVIDER=claude

# 0: show the provider choice only while creating a new video.
# 1: hide that choice and always bind new videos to STUDIO_AGENT_PROVIDER.
STUDIO_AGENT_PROVIDER_LOCKED=0

# Optional executable overrides. Authentication is managed by each CLI itself.
CLAUDE_BIN=claude
CODEX_BIN=codex
ANTIGRAVITY_BIN=agy

# Cross-machine quality tracking. These are optional and contain no credentials.
STUDIO_MACHINE_LABEL=
STUDIO_CLAUDE_MODEL=
STUDIO_CODEX_MODEL=
STUDIO_ANTIGRAVITY_MODEL=
