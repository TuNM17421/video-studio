# These are non-secret Studio policy switches. Do not put API keys in this file.
# Existing Studio videos created before provider support remain bound to Claude.
# claude | codex | antigravity
STUDIO_AGENT_PROVIDER=claude

# 0: show the provider choice only while creating a new video.
# 1: hide that choice and always bind new videos to STUDIO_AGENT_PROVIDER.
STUDIO_AGENT_PROVIDER_LOCKED=0

# Optional executable overrides. Authentication is managed by each CLI itself.
CLAUDE_BIN=claude
CODEX_BIN=codex
ANTIGRAVITY_BIN=agy

# Cross-machine quality tracking. These are optional and contain no credentials.
STUDIO_MACHINE_LABEL=
STUDIO_CLAUDE_MODEL=
STUDIO_CODEX_MODEL=
STUDIO_ANTIGRAVITY_MODEL=

# Cross-review of scene stills: a separate read-only session. These are only the defaults for a NEW video;
# each video keeps its own switch (plan form / scenes step). STUDIO_REVIEW=0 starts new videos with it off.
# auto = an installed CLI other than the one authoring the video (Antigravity → Codex → Claude), the same
# one only if nothing else is installed.
STUDIO_REVIEW=1
STUDIO_QA_PROVIDER=auto
STUDIO_QA_MODEL=

# Optional: Codex cost through a local 9router (telemetry/GATEWAY-9ROUTER.md). Off unless set to 9router.
# Only video stages and visual QA started from the Studio UI go through it; research, images, CLI tools stay direct.
# The API key is looked up by NAME in 9router's local DB, never written here. 9router down → Codex runs direct.
STUDIO_GATEWAY=
STUDIO_GATEWAY_KEY_NAME=video-studio
STUDIO_CODEX_PROFILE=9router

# Optional: ElevenLabs plan price, so voice cost shows in USD (credits are always recorded). Leave empty = not priced.
STUDIO_ELEVENLABS_USD_PER_1K_CREDITS=
