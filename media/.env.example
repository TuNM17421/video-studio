# Copy to media/.env and fill in. Never share or commit media/.env.
# Cloudflare dashboard → R2 → Manage API tokens → Create token (Object Read & Write for one bucket).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public read URL of the bucket, no trailing slash. Either the r2.dev subdomain
# (R2 → bucket → Settings → Public Development URL) or a custom domain.
# media-push writes this into media/manifest.json, which IS committed — that is
# how a teammate who clones the repo sees the videos without configuring anything.
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev
