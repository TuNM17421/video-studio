POSTGRES_PASSWORD=replace-with-a-local-dev-password
COLLECTOR_TOKEN=replace-with-a-local-dev-token
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-dev-password
AI_LOGS_ENABLED=false
# Required only when AI_LOGS_ENABLED=true; base64 encoding of exactly 32 random bytes.
AI_LOG_ENCRYPTION_KEY=
# 0 = giữ vô hạn (mặc định local); VM nên đặt policy rõ ràng.
EVENT_RETENTION_DAYS=0
AI_LOG_RETENTION_DAYS=0
