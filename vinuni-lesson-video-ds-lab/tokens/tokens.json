{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "VinUni Lesson Video design tokens v1.0 — extracted from the Video-studio Remotion repo (src/theme.ts lightColors, src/primitives/*, src/videos/Day01–Day05/rebuild-v1, Day28). Units: px on a 1920×1080 canvas at 30 fps. Mirrors colors_and_type.css.",
  "color": {
    "brand": {
      "blue-900": {
        "$type": "color",
        "$value": "#0b2a4d"
      },
      "blue-800": {
        "$type": "color",
        "$value": "#103e70",
        "$description": "legacy dark bgAlt only"
      },
      "blue-700": {
        "$type": "color",
        "$value": "#134d8b"
      },
      "blue-600": {
        "$type": "color",
        "$value": "#1d6199"
      },
      "blue-400": {
        "$type": "color",
        "$value": "#5d9bc8",
        "$description": "legacy dark accent only"
      },
      "blue-300": {
        "$type": "color",
        "$value": "#8fbdde",
        "$description": "legacy dark muted only"
      },
      "blue-200": {
        "$type": "color",
        "$value": "#bed9ee",
        "$description": "legacy dark accentStrong only"
      },
      "blue-100": {
        "$type": "color",
        "$value": "#e0edf8"
      },
      "blue-50": {
        "$type": "color",
        "$value": "#f2f7fc"
      },
      "red-700": {
        "$type": "color",
        "$value": "#c72127"
      },
      "red-500": {
        "$type": "color",
        "$value": "#d73a40",
        "$description": "legacy dark red only"
      },
      "red-100": {
        "$type": "color",
        "$value": "#ffe0e1"
      },
      "neutral-0": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "neutral-700": {
        "$type": "color",
        "$value": "#4a4a4a"
      }
    },
    "semantic": {
      "bg": {
        "$type": "color",
        "$value": "{color.brand.neutral-0}",
        "$description": "lightColors.bg — canvas"
      },
      "bgAlt": {
        "$type": "color",
        "$value": "{color.brand.blue-50}",
        "$description": "lightColors.bgAlt — card and glassbox fill"
      },
      "text": {
        "$type": "color",
        "$value": "{color.brand.blue-900}",
        "$description": "lightColors.text — ink, subtitle bar background"
      },
      "textMuted": {
        "$type": "color",
        "$value": "{color.brand.neutral-700}",
        "$description": "lightColors.textMuted — secondary copy"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.blue-600}",
        "$description": "lightColors.accent — data, particles, default strokes and flows"
      },
      "accentStrong": {
        "$type": "color",
        "$value": "{color.brand.blue-700}",
        "$description": "lightColors.accentStrong — strong blue labels"
      },
      "red": {
        "$type": "color",
        "$value": "{color.brand.red-700}",
        "$description": "lightColors.red — emphasis, chosen, transformed, action, risk, eyebrow"
      },
      "redSoft": {
        "$type": "color",
        "$value": "{color.brand.red-100}",
        "$description": "lightColors.redSoft — active overlay, warning card, tag fill"
      },
      "dotInactive": {
        "$type": "color",
        "$value": "{color.brand.blue-100}",
        "$description": "lightColors.dotInactive — connector base, bar track, divider, grid"
      }
    },
    "role": {
      "purple": {
        "$type": "color",
        "$value": "#5b4b9a",
        "$description": "role hue — processing / reasoning zone (labels, outlines, soft fills only)"
      },
      "purpleSoft": {
        "$type": "color",
        "$value": "#e8e6f1"
      },
      "green": {
        "$type": "color",
        "$value": "#2f7d57",
        "$description": "role hue — output / passed"
      },
      "greenSoft": {
        "$type": "color",
        "$value": "#e1ede7"
      },
      "orange": {
        "$type": "color",
        "$value": "#c8641e",
        "$description": "role hue — check / action"
      },
      "orangeSoft": {
        "$type": "color",
        "$value": "#f7e9e0"
      },
      "amber": {
        "$type": "color",
        "$value": "#a87a0c",
        "$description": "role hue — memory / waiting"
      },
      "amberSoft": {
        "$type": "color",
        "$value": "#f3ecdd"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Only font. Load weights 500/600/700 with the vietnamese subset."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Code-anatomy scenes only."
      }
    },
    "weight": {
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Maximum rendered weight."
      }
    }
  },
  "typography": {
    "section-number": {
      "$type": "typography",
      "$value": {
        "fontSize": "92px",
        "fontWeight": 700,
        "lineHeight": 1
      },
      "$description": "red"
    },
    "hook": {
      "$type": "typography",
      "$value": {
        "fontSize": "72px",
        "fontWeight": 700,
        "lineHeight": 1.16,
        "letterSpacing": "-1.2px"
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontSize": "62px",
        "fontWeight": 700,
        "lineHeight": 1.25
      }
    },
    "section-label": {
      "$type": "typography",
      "$value": {
        "fontSize": "54px",
        "fontWeight": 700,
        "lineHeight": 1.15
      }
    },
    "title-editorial": {
      "$type": "typography",
      "$value": {
        "fontSize": "54px",
        "fontWeight": 700,
        "lineHeight": 1.08,
        "letterSpacing": "-1.4px"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "50px",
        "fontWeight": 700,
        "lineHeight": 1.16
      },
      "$description": "centered scene title, 40–56px accepted"
    },
    "question": {
      "$type": "typography",
      "$value": {
        "fontSize": "44px",
        "fontWeight": 700,
        "lineHeight": 1.4
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontSize": "40px",
        "fontWeight": 700,
        "lineHeight": 1.25
      }
    },
    "statement": {
      "$type": "typography",
      "$value": {
        "fontSize": "40px",
        "fontWeight": 500,
        "lineHeight": 1.5
      }
    },
    "token": {
      "$type": "typography",
      "$value": {
        "fontSize": "36px",
        "fontWeight": 700,
        "lineHeight": 1
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "29px",
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "$description": "white on text navy, max 78 characters per page"
    },
    "card-title": {
      "$type": "typography",
      "$value": {
        "fontSize": "28px",
        "fontWeight": 700,
        "lineHeight": 1.18
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontSize": "26px",
        "fontWeight": 700,
        "letterSpacing": "5px",
        "textTransform": "uppercase"
      },
      "$description": "red"
    },
    "icon-label": {
      "$type": "typography",
      "$value": {
        "fontSize": "25px",
        "fontWeight": 600,
        "lineHeight": 1.25
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": 1.375
      }
    },
    "kicker": {
      "$type": "typography",
      "$value": {
        "fontSize": "22px",
        "fontWeight": 700,
        "letterSpacing": "4px",
        "textTransform": "uppercase"
      },
      "$description": "red, editorial variant"
    },
    "card-sub": {
      "$type": "typography",
      "$value": {
        "fontSize": "21px",
        "fontWeight": 600,
        "lineHeight": 1.22
      },
      "$description": "textMuted"
    },
    "watermark": {
      "$type": "typography",
      "$value": {
        "fontSize": "21px",
        "fontWeight": 700,
        "letterSpacing": "0.5px"
      },
      "$description": "text at 75% opacity"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontSize": "18px",
        "fontWeight": 700,
        "letterSpacing": "1.2px",
        "textTransform": "uppercase"
      }
    },
    "micro": {
      "$type": "typography",
      "$value": {
        "fontSize": "17px",
        "fontWeight": 700,
        "letterSpacing": "1.1px",
        "textTransform": "uppercase"
      }
    },
    "footer": {
      "$type": "typography",
      "$value": {
        "fontSize": "17px",
        "fontWeight": 600
      },
      "$description": "textMuted"
    }
  },
  "layout": {
    "canvas": {
      "width": {
        "$type": "dimension",
        "$value": "1920px"
      },
      "height": {
        "$type": "dimension",
        "$value": "1080px"
      },
      "fps": {
        "$type": "number",
        "$value": 30
      }
    },
    "eyebrowTop": {
      "$type": "dimension",
      "$value": "70px"
    },
    "titleBaseline": {
      "$type": "dimension",
      "$value": "176px"
    },
    "divider": {
      "$type": "dimension",
      "$value": "x 96→1824 at y 220, 3px dotInactive"
    },
    "tagTop": {
      "$type": "dimension",
      "$value": "228px",
      "$description": "corner tag right edge at x=1792"
    },
    "contentTop": {
      "$type": "dimension",
      "$value": "250px"
    },
    "contentBottom": {
      "$type": "dimension",
      "$value": "960px"
    },
    "captionHeight": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "subtitle bar owns y 984–1080"
    },
    "safeX": {
      "$type": "dimension",
      "$value": "120px"
    },
    "contentXMin": {
      "$type": "dimension",
      "$value": "80px"
    },
    "footerBottom": {
      "$type": "dimension",
      "$value": "48px"
    },
    "watermark": {
      "$type": "dimension",
      "$value": "top 46px, right 56px"
    },
    "editorialGrid": {
      "$type": "dimension",
      "$value": "120px step from 80px, dotInactive 1px at 38% opacity"
    }
  },
  "radius": {
    "bar": {
      "$type": "dimension",
      "$value": "9px"
    },
    "chip": {
      "$type": "dimension",
      "$value": "14px"
    },
    "token": {
      "$type": "dimension",
      "$value": "16px"
    },
    "card": {
      "$type": "dimension",
      "$value": "18px"
    },
    "cardSvg": {
      "$type": "dimension",
      "$value": "22px"
    },
    "glass": {
      "$type": "dimension",
      "$value": "30px"
    },
    "enclosure": {
      "$type": "dimension",
      "$value": "32px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "stroke": {
    "hair": {
      "$type": "dimension",
      "$value": "2px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "2.5px"
    },
    "card": {
      "$type": "dimension",
      "$value": "3px"
    },
    "bracket": {
      "$type": "dimension",
      "$value": "4px"
    },
    "flow": {
      "$type": "dimension",
      "$value": "5px"
    },
    "active": {
      "$type": "dimension",
      "$value": "5px"
    },
    "mark": {
      "$type": "dimension",
      "$value": "8px"
    },
    "dashCard": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          "12px",
          "10px"
        ],
        "lineCap": "round"
      }
    },
    "dashFlow": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          "13px",
          "11px"
        ],
        "lineCap": "round"
      }
    },
    "dashEnclosure": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          "15px",
          "12px"
        ],
        "lineCap": "round"
      }
    }
  },
  "shadow": {
    "hero": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "28px",
        "color": "rgba(11,42,77,0.16)"
      }
    },
    "block": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "10px",
        "blur": "24px",
        "color": "rgba(11,42,77,0.18)"
      }
    },
    "caption": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "-8px",
        "blur": "24px",
        "color": "#e0edf8"
      }
    }
  },
  "motion": {
    "fps": {
      "$type": "number",
      "$value": 30
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "appear / reveal"
      },
      "inOut": {
        "$type": "cubicBezier",
        "$value": [
          0.65,
          0,
          0.35,
          1
        ],
        "$description": "smooth move, underline draw (≈ Easing.inOut(cubic))"
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "hook exit"
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "particle travel, parameter sweeps"
      }
    },
    "durationFrames": {
      "fadeFast": {
        "$type": "number",
        "$value": 12
      },
      "arrow": {
        "$type": "number",
        "$value": 14
      },
      "fade": {
        "$type": "number",
        "$value": 18
      },
      "appear": {
        "$type": "number",
        "$value": 24
      },
      "pulse": {
        "$type": "number",
        "$value": 54,
        "$description": "triangle 0→1→0, peak at 32%"
      },
      "hook": {
        "$type": "number",
        "$value": 150
      }
    },
    "spring": {
      "smooth": {
        "$type": "number",
        "$value": {
          "damping": 200,
          "stiffness": 100,
          "mass": 1
        },
        "$description": "enter scale 0.94→1, no overshoot"
      },
      "pop": {
        "$type": "number",
        "$value": {
          "damping": 13,
          "stiffness": 140,
          "mass": 1
        },
        "$description": "icon / card pop with a small overshoot"
      },
      "chapter": {
        "$type": "number",
        "$value": {
          "damping": 14,
          "stiffness": 120,
          "mass": 1
        },
        "$description": "section number card"
      },
      "badge": {
        "$type": "number",
        "$value": {
          "damping": 12,
          "stiffness": 100,
          "mass": 1
        },
        "$description": "title-card icon, hub center"
      }
    },
    "sceneRhythm": {
      "$type": "string",
      "$value": "input 15–20% · transform 50–60% · output 20–25% of the scene's frames"
    }
  }
}
