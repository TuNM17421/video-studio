# secrets (copy tts-elevenlabs/.env.example → tts-elevenlabs/.env)
.env
**/.env
# dependencies (npm install at the repo root)
node_modules
# generated media — keep the folders, not the heavy files
tts-elevenlabs/cache/
# imported-voice work area: decoded audio, Whisper models and the align venv are all per-machine
voice/cache/
voice/.venv/
*.wav
*.mp3
*.mp4
*.zip
# Background music is audio like any other: it stays out of git and is fetched from storage into
# assets/music/ (see README). The render step skips the music mix when the file is not there.
projects/*/render/*
!projects/*/render/.gitkeep
# Media nặng đẩy lên Cloudflare R2: file ở máy, chỉ commit media/manifest.json
/media/files/*
!/media/files/.gitkeep
# Claude Design sync build output (regenerated by /design-sync)
ds-bundle/
# Ghi chú quyết định nội bộ: giữ ở máy, không đẩy lên remote
docs/
# QA stills and Video Studio's per-machine run state (agent session ids, logs)
projects/*/qa/
projects/*/.studio/
# Per-video inputs and generated deliverables stay local. Existing tracked Day02
# templates remain tracked; add a future template explicitly when it is approved.
/projects/*/
/tts-elevenlabs/out/*/
/voice/out/*/
/projects/*/voice-script/
/transcripts/Day*/*
/chapters/Day*/*
/vinuni-lesson-video-ds/ui_kits/lesson-video/videos/*/
# Bundle dựng sẵn của design system. Nó được build từ ui_kits/.../videos/*/ — thư mục bị bỏ qua ngay
# dòng trên — nên bundle commit lên sẽ mang theo video riêng của máy người build và thiếu video của
# người khác (bản cũ trong git từng chứa d1, d1-2, d2-v2, d3 mà repo không hề có). Không đẩy lên nữa:
# `npm install` tự build (postinstall), và `npm run verify` báo nếu thiếu.
/vinuni-lesson-video-ds/dist/
# Skills pulled in by `npx autoskills` — general web/React/testing guides, unrelated to making lesson
# videos. Each member installs what they want locally; only the skills this team writes are tracked
# (.claude/skills/make-video, .claude/skills/voice-align-check). Add new generated names here.
.agents/
skills-lock.json
.claude/skills/accessibility/
.claude/skills/composition-patterns/
.claude/skills/frontend-design/
.claude/skills/nodejs-backend-patterns/
.claude/skills/nodejs-best-practices/
.claude/skills/playwright-best-practices/
.claude/skills/react-best-practices/
.claude/skills/seo/
